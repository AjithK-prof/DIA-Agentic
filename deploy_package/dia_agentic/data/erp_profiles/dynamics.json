{
  "erp": "Dynamics",
  "versions": ["Dynamics 365", "Dynamics AX", "Dynamics NAV"],
  "module": "invoices",
  "description": "Standard Microsoft Dynamics AP Invoice field mappings",
  "mappings": {
    "AccountNum":           "vendor_number",
    "VendorAccountNumber":  "vendor_number",
    "VendorName":           "vendor_name",
    "DataAreaId":           "company_code",
    "LegalEntityId":        "company_code",
    "InvoiceId":            "original_invoice_no",
    "VendInvoiceJournalId": "system_invoice_no",
    "DocumentNum":          "ref_no",
    "ApprovalStatus":       "invoice_status",
    "InvoiceDate":          "date_documented",
    "PostingDate":          "date_captured",
    "ApprovedBy":           "authorized_by",
    "TaxAmount":            "amount_vat_lc",
    "InvoiceAmount":        "amount_incl_lc",
    "LineAmountExclTax":    "amount_excl_lc",
    "CurrencyCode":         "reference_currency",
    "Description":          "invoice_description",
    "PaymentMethod":        "payment_type",
    "PaymentReference":     "payment_number",
    "PaymentDate":          "payment_date",
    "SettledAmount":        "payment_amount",
    "DueDate":              "due_date",
    "ScheduledPaymentDate": "scheduled_pay_date",
    "DocumentType":         "invoice_type",
    "LineNum":              "invoice_line_ref",
    "FiscalPeriod":         "fiscal_year",
    "PostingProfile":       "gl_indicator"
  }
}
